---
import Base from '../../layouts/Base.astro';
import ResourceRow from '../../components/ResourceRow.astro';
import SignupStrip from '../../components/SignupStrip.astro';
import ToolRow from '../../components/ToolRow.astro';
import { categories, type Category } from '../../lib/resources';
import { tools } from '../../tools/registry';
import { getCollection } from 'astro:content';

const resources = await getCollection('resources');
const filled = (Object.keys(categories) as Category[])
  .map((key) => ({ key, ...categories[key], items: resources.filter((r) => r.data.category === key) }))
  .filter((category) => category.items.length);
---
<Base title="Resources" description="Tools, lists and guides for engineers and systems thinkers.">
  <div class="prose"><h1>Resources</h1><p class="lede">Tools, lists and guides for engineers and systems thinkers.</p></div>
  <div class="prose"><h2><a href="/resources/tools/">Tools</a></h2></div>
  <ol class="rows">{tools.map((tool) => <ToolRow tool={tool} />)}</ol>
  {filled.map((category) => (
    <>
      <div class="prose"><h2><a href={`/resources/${category.key}/`}>{category.title}</a></h2></div>
      <ol class="rows">{category.items.map((r) => <ResourceRow {...r.data} />)}</ol>
    </>
  ))}
  <SignupStrip />
</Base>
