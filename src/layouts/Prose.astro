---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  meta?: string;
  schema?: object;
}
const { title, description, type, meta, schema } = Astro.props;
---
<Base title={title} description={description} type={type} schema={schema}>
  <article class="prose">
    <h1>{title}</h1>
    {meta && <p class="meta">{meta}</p>}
    <slot />
  </article>
</Base>
